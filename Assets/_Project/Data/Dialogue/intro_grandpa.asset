  id: intro_grandpa
  lines:
  - speaker:
      english: Grandpa
      thai: "\u0E04\u0E38\u0E13\u0E1B\u0E39\u0E48"
    text:
      english: Welcome home, child.
      thai: "\u0E22\u0E34\u0E19\u0E14\u0E35\u0E15\u0E49\u0E2D\u0E19\u0E23\u0E31\u0E1A\u0E01\u0E25\u0E31\u0E1A\u0E1A\u0E49\u0E32\u0E19\u0E19\u0E30"
  - speaker:
      english: Grandpa
      thai: "\u0E04\u0E38\u0E13\u0E1B\u0E39\u0E48"
    text:
      english: The old shed holds a secret.
      thai: "\u0E42\u0E23\u0E07\u0E40\u0E01\u0E47\u0E1A\u0E02\u0E2D\u0E07\u0E40\u0E01\u0E48\u0E32\u0E21\u0E35\u0E04\u0E27\u0E32\u0E21\u0E25\u0E31\u0E1A\u0E0B\u0E48\u0E2D\u0E19\u0E2D\u0E22\u0E39\u0E48"
